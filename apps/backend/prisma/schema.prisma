generator client {
  provider     = "prisma-client"
  // output       = "../src/generated/prisma"
  output       = "../../../packages/shared/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  isActive         Boolean  @default(true)
  isBootstrapAdmin Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users") // Name of the table
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // Creates a normal database index on expiresAt. It is not unique, so many users/tokens can have the same expiresAt value. 
  @@map("refresh_tokens") // Name of the table
}
