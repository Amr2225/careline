generator client {
  provider        = "prisma-client-js"
  // output       = "../src/generated/prisma"
  output          = "../../../packages/shared/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum Action {
  READ
  WRITE
  UPDATE
  DELETE
  UPDATE_MEDICAL
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  isActive         Boolean  @default(true)
  phoneNumber      String?  @unique
  isBootstrapAdmin Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens RefreshToken[]
  userRoles     UserRole[]     @relation("UserRoles")
  assignedRoles UserRole[]     @relation("AssignedRoles")
  patient       Patient?

  @@map("users") // Name of the table
}

model Patient {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dateOfBirth           DateTime @db.Date
  gender                Gender
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // medical history
  bloodType          BloodType?
  allergies          String? // free text
  chronicConditions  String? // free text
  currentMedications String? // free text
  medicalNotes       String? // free text, doctor-editable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@map("patients")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // Creates a normal database index on expiresAt. It is not unique, so many users/tokens can have the same expiresAt value. 
  @@map("refresh_tokens") // Name of the table
}

model Module {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@map("modules")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  moduleId String
  action   Action

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([roleId, moduleId, action])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("AssignedRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model AvailableSlot {
  id           String        @id @default(cuid())
  startTime    DateTime      @unique
  capacity     Int
  bookedCount  Int           @default(0)
  templateId   String?
  template     SlotTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  createdAt    DateTime      @default(now())

  @@index([startTime])
  @@index([templateId])
  @@map("available_slots")
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  slotId      String
  status      AppointmentStatus @default(BOOKED)
  bookedAt    DateTime          @default(now())
  cancelledAt DateTime?
  updatedAt   DateTime          @updatedAt

  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  slot    AvailableSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([slotId, status])
  @@map("appointments")
}

enum AppointmentStatus {
  BOOKED
  LATE_ARRIVING // auto-flipped at slotTime - 5min if no scan yet
  ARRIVED
  IN_PROGRESS
  DONE
  NO_SHOW
  CANCELLED
}

model SlotTemplate {
  id               String    @id @default(cuid())
  name             String
  weekday          Int
  startTime        String
  endTime          String
  capacityOverride Int?
  isActive         Boolean   @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  slots AvailableSlot[]

  @@map("slot_templates")
}

model Setting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("settings")
}
