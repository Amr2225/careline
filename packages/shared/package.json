{
  "name": "@careline/shared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "exports": {
    "./prisma/*": {
      "types": "./prisma/*.d.ts",
      "default": "./prisma/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    }
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}

